{
  "name": "ai-business-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0 <13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "infra:up": "docker compose -f infra/compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/compose.dev.yml down",
    "infra:ps": "docker compose -f infra/compose.dev.yml ps",
    "infra:logs": "docker compose -f infra/compose.dev.yml logs -f"
  },
  "devDependencies": {
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^6.0.3"
  }
}
